<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="比特一瞥 · BitGlance" Width="456" Height="618" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FCFBF8"/><SolidColorBrush x:Key="Ink" Color="#242B29"/><SolidColorBrush x:Key="Muted" Color="#828980"/><SolidColorBrush x:Key="Line" Color="#E8E9E2"/><SolidColorBrush x:Key="Soft" Color="#F2F3EE"/><SolidColorBrush x:Key="Accent" Color="#E9812D"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#E9812D"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="7">
  <Border x:Name="Shell" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="19" IsHitTestVisible="False"/>
  <Grid>
   <Grid x:Name="FullView" Margin="25,0,25,20">
    <Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="108"/><RowDefinition Height="88"/><RowDefinition Height="161"/><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" Margin="-10,0,-14,0">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="比特一瞥" FontWeight="SemiBold" FontSize="12"/><TextBlock Text=" / BITGLANCE" FontSize="9" Margin="6,3,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="ThemeButton" Content="◐" FontSize="16" ToolTip="切换明暗主题" AutomationProperties.Name="切换明暗主题" Padding="9,5"/>
      <Button x:Name="PinButton" Content="置顶" FontSize="10" ToolTip="主窗口置顶" Padding="8,6"/>
      <Button x:Name="HideButton" Content="—" ToolTip="隐藏到系统托盘" AutomationProperties.Name="隐藏到系统托盘" Padding="9,6"/>
      <Button x:Name="CloseButton" Content="×" FontSize="17" ToolTip="退出应用" AutomationProperties.Name="退出应用" Padding="9,3"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,5,0,10">
     <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="BtcButton" Content="BTC" FontFamily="Segoe UI" FontWeight="SemiBold" Padding="12,5" Margin="0,0,5,0"/><Button x:Name="EthButton" Content="ETH" FontFamily="Segoe UI" FontWeight="SemiBold" Padding="12,5" Margin="0,0,5,0"/><Button x:Name="SolButton" Content="SOL" FontFamily="Segoe UI" FontWeight="SemiBold" Padding="12,5"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="41" Height="41" Background="#E9812D" CornerRadius="21"><TextBlock x:Name="AssetGlyph" Text="₿" FontFamily="Segoe UI" FontSize="27" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border>
      <StackPanel Margin="12,0,0,0"><TextBlock x:Name="AssetName" Text="Bitcoin" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="20"/><TextBlock x:Name="PairLabel" Text="BTC / USDT 永续" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
     </StackPanel>
     <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Soft}" CornerRadius="11" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#E9812D" Width="5" Height="5" Margin="0,0,5,0"/><TextBlock x:Name="LiveLabel" Text="连接中" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
    </Grid>
    <StackPanel Grid.Row="2">
     <StackPanel Orientation="Horizontal"><ContentControl x:Name="PriceTarget" Cursor="Hand" ToolTip="双击价格进入迷你悬浮窗 · Ctrl+M"><TextBlock x:Name="PriceLabel" Text="— —" FontFamily="Segoe UI" FontSize="47" FontWeight="SemiBold" Margin="-2,-8,0,0"/></ContentControl><TextBlock x:Name="UnitLabel" Text="USDT" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="9,0,0,11"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Border x:Name="ChangePill" Background="{DynamicResource Soft}" CornerRadius="6" Padding="7,4"><TextBlock x:Name="ChangeLabel" Text="等待行情" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock x:Name="ChangeCaption" Text="过去 24 小时" Foreground="{DynamicResource Muted}" Margin="9,4,0,0" FontSize="11"/></StackPanel>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,9,0,0">
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="107"/><RowDefinition Height="22"/></Grid.RowDefinitions>
     <TextBlock x:Name="ChartTitle" Text="价格走势" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DayButton" Content="24H" FontFamily="Segoe UI" FontSize="10" Background="{DynamicResource Soft}" Foreground="{DynamicResource Ink}" Padding="9,4"/><Button x:Name="WeekButton" Content="7D" FontFamily="Segoe UI" FontSize="10" Padding="9,4"/></StackPanel>
     <Grid Grid.Row="1"><ContentControl x:Name="ChartHost"/><TextBlock x:Name="ChartMessage" Text="正在读取真实行情…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid>
     <TextBlock Grid.Row="2" x:Name="ChartStart" Text="24 小时前" FontFamily="Segoe UI" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Row="2" x:Name="ChartEnd" Text="现在" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
    </Grid>
    <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Margin="0,8,0,4" Padding="0,13,0,9">
     <UniformGrid Columns="3"><StackPanel><TextBlock Text="24h 最高" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="HighLabel" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="24h 最低" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="LowLabel" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock x:Name="VolumeCaption" Text="24h 成交量 · BTC" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="VolumeLabel" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15" Margin="0,6,0,0"/></StackPanel></UniformGrid>
    </Border>
    <Grid Grid.Row="5" Margin="0,9,0,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="SourceLabel" Text="Bitget · USDT 永续 · 最新成交价" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="UpdateLabel" Text="首次连接中…" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
     <Button x:Name="RefreshButton" Content="↻" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,0" ToolTip="立即刷新 · F5" AutomationProperties.Name="立即刷新"/>
     <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><TextBlock Text="双击价格，进入迷你悬浮窗" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="SettingsButton" Grid.Column="1" Content="设置" Height="32" Background="{DynamicResource Soft}" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid>
    </Grid>
   </Grid>
   <Grid x:Name="MiniView" Visibility="Collapsed" Background="Transparent" Margin="13,5">
    <ContentControl x:Name="MiniTarget" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel x:Name="MiniContent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="MiniPrice" Text="— —" FontSize="24" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock x:Name="MiniUnit" Text="USDT" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,4"/></StackPanel><TextBlock x:Name="MiniStatus" Text="正在获取价格" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" HorizontalAlignment="Center"/></StackPanel></ContentControl>
   </Grid>
  </Grid>
 </Grid>
</Window>

